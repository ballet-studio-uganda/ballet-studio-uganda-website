# Copy to .env (or export these) before deploying. Every value below has a
# development-friendly default, so none of them are needed to run locally.

DJANGO_SECRET_KEY=change-me-to-a-random-50-character-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=balletdancestudioug.com,www.balletdancestudioug.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://balletdancestudioug.com

# Leave unset to use the bundled SQLite file.
DATABASE_URL=postgres://user:password@localhost:5432/bdsu

# Leave EMAIL_HOST unset and mail is printed to the console instead of sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Ballet Dance Studio UG <info@balletdancestudioug.com>
